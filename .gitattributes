# Store every text file with LF line endings, and check it out as LF on
# every platform. Without this rule, Windows editors rewrite whole files and
# every diff becomes a line-ending diff.
* text=auto eol=lf

# Windows scripts keep CRLF so their shells read them correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are stored and checked out unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.xls binary
*.xlsx binary
*.parquet binary
